# Quotepaper Studio — server-side API keys (set these in Vercel → Project → Settings → Environment Variables)
# The app runs WITHOUT any of these — keyless sources (Quotable mirror, DummyJSON,
# Openverse, Art Institute, Lorem Picsum) and the bundled offline corpus keep it working.
# Each key simply enables an additional provider in the redundancy chain.

# Pixabay — https://pixabay.com/api/docs/  (free key)
PIXABAY_API_KEY=

# Unsplash — https://unsplash.com/developers  (Access Key; keep secret, rotate the old exposed one)
UNSPLASH_ACCESS_KEY=

# Pexels — https://www.pexels.com/api/  (free key)
PEXELS_API_KEY=

# API Ninjas quotes — https://api-ninjas.com/  (optional; adds category-tagged quotes)
API_NINJAS_KEY=

# Openverse — optional bearer token for higher rate limits (anonymous works fine)
# https://api.openverse.org/v1/#tag/auth
OPENVERSE_TOKEN=

# img-proxy — optional extra allowed image host suffixes (comma-separated)
IMG_PROXY_ALLOWED_HOSTS=
